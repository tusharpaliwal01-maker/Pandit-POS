rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.]+$');
    }

    // Diagnostics & Connection Test Document
    match /test/{docId} {
      allow read, write: if isValidId(docId);
    }

    // Retail Store & Branch Locations
    match /shops/{shopId} {
      allow read, write: if isValidId(shopId);
    }

    // Inventory & Stock Catalog
    match /products/{productId} {
      allow read, write: if isValidId(productId);
    }

    // Customers & Khata Ledger
    match /customers/{customerId} {
      allow read, write: if isValidId(customerId);
    }

    // Point of Sale Invoices & Receipts
    match /invoices/{invoiceId} {
      allow read, write: if isValidId(invoiceId);
    }

    // System Operators & Staff
    match /users/{userId} {
      allow read, write: if isValidId(userId);
    }
  }
}
