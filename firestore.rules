rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Diagnostics & Connection Test Document
    match /test/{docId} {
      allow read, write: if isValidId(docId);
    }

    // Retail Store & Branch Locations
    match /shops/{shopId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(shopId);
    }

    // Inventory & Stock Catalog
    match /products/{productId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && isValidId(productId);
    }

    // Customers & Khata Ledger
    match /customers/{customerId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && isValidId(customerId);
    }

    // Point of Sale Invoices & Receipts
    match /invoices/{invoiceId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(invoiceId);
      allow update, delete: if isSignedIn() && isValidId(invoiceId);
    }

    // System Operators & Staff
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(userId);
      allow delete: if isSignedIn() && isValidId(userId);
    }
  }
}
